* { box-sizing: border-box; }
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
}
header {
    background: #172554;
    color: white;
    padding: 16px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.brand { font-weight: 700; }
nav a { color: white; text-decoration: none; margin-left: 22px; }
.container { max-width: 1150px; margin: 0 auto; padding: 35px 20px; }
.hero, .report-head {
    display: flex; justify-content: space-between; gap: 25px; align-items: center;
    margin-bottom: 28px;
}
.eyebrow { text-transform: uppercase; letter-spacing: 1.5px; font-size: 12px; font-weight: 700; color: #5267b8; }
h1 { margin: 6px 0; font-size: 34px; }
h2 { margin-top: 0; }
.button, .small-button, .secondary, .danger {
    display: inline-block; border: 0; cursor: pointer; text-decoration: none;
    border-radius: 9px; padding: 11px 17px; font-weight: 700;
}
.button { background: #2563eb; color: white; }
.secondary { background: #e8edf7; color: #172033; }
.danger { background: #dc2626; color: white; }
.small-button { background: #e8edf7; color: #172033; padding: 7px 11px; }
.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 22px; }
.card, .panel, .form-panel, .report {
    background: white; border: 1px solid #e1e6ef; border-radius: 15px;
    box-shadow: 0 5px 20px rgba(20, 35, 70, .06);
}
.card { padding: 22px; }
.card span, .metrics span { display: block; color: #657089; font-size: 13px; }
.card strong { display: block; font-size: 28px; margin-top: 8px; }
.panel { padding: 22px; }
.panel-head { display: flex; justify-content: space-between; align-items: center; }
.panel-head span { color: #657089; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; margin-top: 12px; }
th, td { text-align: left; padding: 13px 10px; border-bottom: 1px solid #edf0f5; }
th { font-size: 13px; color: #657089; }
.grade { font-weight: 700; }
.empty { padding: 40px 10px; text-align: center; color: #657089; }
.form-panel, .report { padding: 30px; max-width: 900px; margin: auto; }
.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 17px; margin: 25px 0; }
label { display: block; font-weight: 700; font-size: 14px; }
input, textarea {
    width: 100%; margin-top: 7px; padding: 12px; border: 1px solid #d5dbe6;
    border-radius: 8px; font: inherit;
}
textarea { resize: vertical; }
.actions { display: flex; gap: 10px; align-items: center; margin-top: 22px; }
.actions form { margin: 0; }
.metrics { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin: 25px 0; }
.metrics div { padding: 16px; background: #f4f7fb; border-radius: 10px; }
.metrics b { display: block; margin-top: 6px; font-size: 20px; }
.score { font-size: 42px; font-weight: 800; text-align: right; }
.score small { font-size: 16px; color: #657089; }
.score span { display: block; font-size: 16px; }
.report-text { border-top: 1px solid #e5e9f0; padding-top: 20px; }
.alert { padding: 12px 15px; border-radius: 8px; margin-bottom: 15px; }
.alert.success { background: #dcfce7; color: #166534; }
.alert.error { background: #fee2e2; color: #991b1b; }
.muted { color: #657089; }

@media (max-width: 750px) {
    header { flex-direction: column; gap: 12px; }
    nav a { margin: 0 8px; }
    .hero, .report-head { flex-direction: column; align-items: flex-start; }
    .cards, .grid, .metrics { grid-template-columns: 1fr; }
    .score { text-align: left; }
}
