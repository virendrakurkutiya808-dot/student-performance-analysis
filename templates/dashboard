{% extends "base.html" %}
{% block title %}Dashboard{% endblock %}

{% block content %}
<section class="hero">
    <div>
        <p class="eyebrow">GTU Micro Project • BE05000231</p>
        <h1>Student Performance Dashboard</h1>
        <p>Store student data, calculate performance and keep individual reports.</p>
    </div>
    <a class="button" href="{{ url_for('add_student') }}">+ Add Student</a>
</section>

<div class="cards">
    <div class="card"><span>Total Students</span><strong>{{ total }}</strong></div>
    <div class="card"><span>Class Average</span><strong>{{ class_average }}</strong></div>
    <div class="card"><span>Storage</span><strong>SQLite</strong></div>
</div>

<div class="panel">
    <div class="panel-head">
        <h2>Student Records</h2>
        <span>{{ total }} record(s)</span>
    </div>

    {% if students %}
    <div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th><th>Name</th><th>Attendance</th>
                <th>Average</th><th>Grade</th><th>Report</th><th>Action</th>
            </tr>
        </thead>
        <tbody>
        {% for s in students %}
            <tr>
                <td>{{ s.student_id }}</td>
                <td>{{ s.name }}</td>
                <td>{{ s.attendance }}%</td>
                <td><b>{{ s.average }}</b></td>
                <td><span class="grade">{{ s.grade }}</span></td>
                <td>
                    {% if s.report %}Saved{% else %}Not added{% endif %}
                </td>
                <td><a class="small-button" href="{{ url_for('student_detail', student_db_id=s.id) }}">View</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% else %}
        <div class="empty">No student records yet. Add your first student.</div>
    {% endif %}
</div>
{% endblock %}
