{% extends "base.html" %}
{% block title %}Add Student{% endblock %}

{% block content %}
<div class="form-panel">
    <p class="eyebrow">Student Record</p>
    <h1>Add Student</h1>
    <p class="muted">Enter marks and performance information. Average and grade are calculated automatically.</p>

    <form method="post">
        <div class="grid">
            <label>Student ID
                <input name="student_id" required placeholder="e.g. 101">
            </label>

            <label>Student Name
                <input name="name" required placeholder="e.g. Rahul">
            </label>

            <label>Study Hours
                <input type="number" name="study_hours" min="0" step="0.1" required>
            </label>

            <label>Attendance (%)
                <input type="number" name="attendance" min="0" max="100" step="0.1" required>
            </label>

            <label>Assignment Marks
                <input type="number" name="assignment" min="0" max="100" required>
            </label>

            <label>Mid-Term Marks
                <input type="number" name="mid_term" min="0" max="100" required>
            </label>

            <label>Final Exam Marks
                <input type="number" name="final_exam" min="0" max="100" required>
            </label>
        </div>

        <label>Student Report / Remarks
            <textarea name="report" rows="5" placeholder="Example: Good performance. Improve attendance and final exam preparation."></textarea>
        </label>

        <div class="actions">
            <button class="button" type="submit">Save Student</button>
            <a class="secondary" href="{{ url_for('dashboard') }}">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
